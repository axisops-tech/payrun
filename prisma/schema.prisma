generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["payrun"]
}

model Handle {
  id           String        @id @default(cuid())
  handle       String        @unique
  nimiqAddress String?
  claimedAt    DateTime?
  createdAt    DateTime      @default(now())
  rosterEntries RosterEntry[]
  payItems     PayItem[]

  @@map("handles")
  @@schema("payrun")
}

model RosterEntry {
  id           String   @id @default(cuid())
  ownerAddress String
  handleId     String
  handle       Handle   @relation(fields: [handleId], references: [id], onDelete: Cascade)
  amountLuna   Int
  cadence      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerAddress, handleId])
  @@map("roster_entries")
  @@schema("payrun")
}

model PayCycle {
  id           String    @id @default(cuid())
  ownerAddress String
  periodKey    String
  status       String
  preparedAt   DateTime  @default(now())
  completedAt  DateTime?
  items        PayItem[]

  @@index([ownerAddress, periodKey])
  @@map("pay_cycles")
  @@schema("payrun")
}

model PayItem {
  id                 String   @id @default(cuid())
  cycleId            String
  cycle              PayCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  handleId           String
  handle             Handle   @relation(fields: [handleId], references: [id], onDelete: Cascade)
  amountLuna         Int
  previousAmountLuna Int?
  flagsJson          String
  memo               String
  txHash             String?
  status             String
  updatedAt          DateTime @updatedAt

  @@map("pay_items")
  @@schema("payrun")
}
